# ACM Hub configuration.
# Copy to `.env` and fill in real values. NEVER commit a populated .env file.

# --- Discord (required) -----------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Right-click your server icon with Developer Mode enabled -> Copy Server ID
DISCORD_GUILD_ID=

# --- Channels (required) ----------------------------------------------------
# Right-click a channel with Developer Mode enabled -> Copy Channel ID
# Public channel where approved opportunities are published.
OPPORTUNITIES_CHANNEL_ID=
# Private officer-only channel where the review queue is posted.
OFFICER_REVIEW_CHANNEL_ID=
# Optional. Approved research mentorships post here when set; otherwise they
# use OPPORTUNITIES_CHANNEL_ID.
RESEARCH_CHANNEL_ID=

# --- Database (required) ----------------------------------------------------
# Must use the asyncpg driver. docker compose supplies this automatically.
DATABASE_URL=postgresql+asyncpg://acm_hub:acm_hub@localhost:5432/acm_hub

# --- Optional ---------------------------------------------------------------
# Discord role ID allowed to use /acm-admin commands. When unset, ACM Hub falls
# back to the Discord "Manage Guild" permission check.
OFFICER_ROLE_ID=
# Unauthenticated github.com raw fetches are rate limited per IP. A classic
# token with NO scopes is enough and raises the limit.
GITHUB_TOKEN=
# When acm.org blocks automated fetches (HTTP 403 / Cloudflare), set false to
# skip the official ACM conferences collector. Other sources keep running.
ACM_CONFERENCES_ENABLED=true
# Optional override for the conferences listing URL (default: acm.org/conferences).
ACM_CONFERENCES_URL=
# text | console
LOG_FORMAT=console
LOG_LEVEL=INFO
# Collector cadences, in minutes.
INTERNSHIP_COLLECTION_INTERVAL_MINUTES=180
# Set to false to disable the background scheduler (useful for local UI work).
SCHEDULER_ENABLED=true
# Cap on how many newly discovered opportunities are pushed to the officer
# review channel per collection cycle, so a first run cannot flood the channel.
REVIEW_QUEUE_BATCH_LIMIT=10
# Cap on how many auto-approved opportunities are posted per cycle.
PUBLISH_BATCH_LIMIT=10
# Infer closures from a source no longer listing a posting. A failed or
# truncated feed never mass-closes; this is the master switch.
CLOSURE_DETECTION_ENABLED=true
CLOSURE_MIN_VOLUME_RATIO=0.5
CLOSURE_MAX_CLOSE_RATIO=0.3
